# Salin menjadi .env di folder yang sama dengan docker-compose.yml.
# File .env tidak ikut ter-commit.

POSTGRES_USER=hrd
POSTGRES_PASSWORD=ganti-password-ini
POSTGRES_DB=hrd_db
POSTGRES_PORT=5432

REDIS_PORT=6379
BACKEND_PORT=3000

NODE_ENV=production

# WAJIB minimal 32 karakter. Generate dengan: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h
MOBILE_SESSION_DAYS=30

CORS_ORIGINS=http://localhost:3001
BCRYPT_ROUNDS=12

# --- Kebijakan presensi ---
APP_TIMEZONE=Asia/Jakarta
ATTENDANCE_LATE_TOLERANCE_MINUTES=5
ATTENDANCE_MIN_OVERTIME_MINUTES=30
ATTENDANCE_MAX_SHIFT_HOURS=16
ATTENDANCE_OFFLINE_MAX_HOURS=72

# --- Pengenalan wajah ---
# Paket model: buffalo_s (14 MB, cepat) atau buffalo_l (182 MB, lebih akurat)
FACE_MODEL_PACK=buffalo_s
FACE_MATCH_THRESHOLD=0.45
FACE_RECOGNITION_ENABLED=true
FACE_STORE_CHECKIN_IMAGES=false

# Deteksi wajah hidup. Setel ulang ambangnya setelah diuji dengan
# ponsel dan pencahayaan lokasi Anda sendiri.
FACE_LIVENESS_ENABLED=true
FACE_LIVENESS_THRESHOLD=0.6

# --- Pemantauan WhatsApp (Belly's) ---
# Hanya nomor WhatsApp PERUSAHAAN yang boleh dipantau, bukan nomor pribadi.
BELLYS_WEBHOOK_SECRET=
WHATSAPP_MONITORING_ENABLED=false
# Masa simpan arsip dalam hari; 0 = tanpa batas. Penghapusan dipanggil dari
# cron di luar: POST /api/whatsapp/retention/purge
WHATSAPP_RETENTION_DAYS=0

# --- Enkripsi kolom data pribadi ---
# WAJIB kalau WHATSAPP_MONITORING_ENABLED=true. Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# --- Driver WhatsApp (Baileys) ---
# Backend membuka koneksi WhatsApp sendiri. Satu nomor = satu proses.
WHATSAPP_BAILEYS_ENABLED=false

# --- Notifikasi push (Firebase Cloud Messaging) ---
# Berkas service account harus di-mount ke dalam container.
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=

# Batas ukuran dokumen karyawan (byte).
DOCUMENT_MAX_BYTES=5000000
