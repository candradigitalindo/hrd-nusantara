# Konfigurasi stack produksi (docker-compose.prod.yml).
# Salin menjadi .env.prod lalu isi. Berkas .env.prod TIDAK ikut ter-commit.
#
#   cp .env.prod.example .env.prod
#   openssl rand -base64 48   # untuk JWT_SECRET
#   openssl rand -base64 32   # untuk FIELD_ENCRYPTION_KEY
#
# Tidak ada POSTGRES_PORT / REDIS_PORT / BACKEND_PORT di sini: stack produksi
# sengaja tidak membuka port apa pun ke host supaya tidak bentrok dengan
# aplikasi lain di server yang sama.

POSTGRES_USER=hrd
POSTGRES_PASSWORD=
POSTGRES_DB=hrd_db

# WAJIB minimal 32 karakter.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origin publik aplikasi. Pisahkan dengan koma kalau lebih dari satu.
CORS_ORIGINS=https://hrd.nbp.co.id
BCRYPT_ROUNDS=12

# Lapis proxy tepercaya di depan aplikasi. 1 untuk stack ini (nginx di
# depannya). Tanpa ini, rate limit login memakai IP proxy — sepuluh percobaan
# gagal dari siapa pun akan mengunci semua orang.
TRUST_PROXY_HOPS=1

# --- Kebijakan presensi ---
APP_TIMEZONE=Asia/Jakarta
ATTENDANCE_LATE_TOLERANCE_MINUTES=5
ATTENDANCE_MIN_OVERTIME_MINUTES=30
ATTENDANCE_MAX_SHIFT_HOURS=16

# --- Pengenalan wajah ---
# buffalo_s (14 MB, cepat) atau buffalo_l (182 MB, lebih akurat).
FACE_MODEL_PACK=buffalo_s
FACE_MATCH_THRESHOLD=0.45
FACE_RECOGNITION_ENABLED=true
FACE_STORE_CHECKIN_IMAGES=false
FACE_ONNX_THREADS=2

FACE_LIVENESS_ENABLED=true
FACE_LIVENESS_THRESHOLD=0.6

# --- Enkripsi kolom data pribadi --- (WAJIB, backend menolak boot tanpa ini)
FIELD_ENCRYPTION_KEY=

# --- Pemantauan WhatsApp --- (bawaan mati)
# Boleh dikosongkan selama pemantauan mati. Kalau diisi, minimal 32 karakter:
# openssl rand -base64 48
BELLYS_WEBHOOK_SECRET=
WHATSAPP_MONITORING_ENABLED=false
WHATSAPP_RETENTION_DAYS=0
WHATSAPP_BAILEYS_ENABLED=false

# --- Notifikasi push (Firebase) --- (bawaan mati)
# Taruh berkas JSON-nya di backend/secrets/, ia di-mount read-only ke container.
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-service-account.json

DOCUMENT_MAX_BYTES=5000000
