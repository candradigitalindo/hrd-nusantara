# Salin menjadi backend/.env.test sebelum menjalankan `npm test`.
# Database HARUS terpisah dari development — test mengosongkan semua tabel.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hrd_db_test?schema=public"
JWT_SECRET="secret-khusus-testing-minimal-32-karakter-panjangnya"
JWT_EXPIRES_IN="1h"
NODE_ENV=test
PORT=3099
BCRYPT_ROUNDS=10
CORS_ORIGINS="http://localhost:3001"

# --- Kebijakan presensi ---
# Zona waktu operasional; jadwal shift disimpan sebagai tanggal + "HH:mm" lokal.
APP_TIMEZONE="Asia/Jakarta"
# Datang dalam toleransi ini dihitung tepat waktu.
ATTENDANCE_LATE_TOLERANCE_MINUTES=5
# Kerja melewati jam pulang baru dihitung lembur setelah ambang ini.
ATTENDANCE_MIN_OVERTIME_MINUTES=30
# Presensi terbuka yang lebih tua dari ini dianggap lupa check-out.
ATTENDANCE_MAX_SHIFT_HOURS=16

# --- Pengenalan wajah (berjalan di server sendiri, tanpa layanan luar) ---
# Unduh bobot model lebih dulu: npm run models:download
FACE_MODEL_DIR="./models/buffalo_s"
FACE_MODEL_NAME="buffalo_s"
FACE_ONNX_THREADS=2
# Ambang kemiripan kosinus. Terukur ~0,97 untuk orang yang sama dan ~-0,01
# untuk orang berbeda, jadi 0,45 berada jauh dari keduanya.
FACE_MATCH_THRESHOLD=0.45
FACE_DETECTION_THRESHOLD=0.5
FACE_MIN_BOX_PX=60
FACE_MAX_IMAGE_BYTES=8000000
FACE_RECOGNITION_ENABLED=true
UPLOAD_DIR="./uploads"
# Selfie tiap check-in tidak disimpan secara bawaan (lihat catatan UU PDP).
FACE_STORE_CHECKIN_IMAGES=false

# --- Deteksi wajah hidup (anti-spoofing) ---
FACE_ANTISPOOF_MODEL="./models/antispoof/minifasnet_v2.onnx"
# Presensi ditolak bila peluang "wajah hidup" di bawah ambang ini.
# Terukur: potret asli >= 0,9998; simulasi foto-di-layar <= 0,0001.
# Setel ulang setelah diuji dengan ponsel dan pencahayaan Anda sendiri.
FACE_LIVENESS_THRESHOLD=0.6
FACE_LIVENESS_ENABLED=true

# --- Integrasi WhatsApp (Belly's) ---
# Kunci bersama untuk tanda tangan webhook. Generate: openssl rand -base64 48
BELLYS_WEBHOOK_SECRET="secret-webhook-bellys-minimal-32-karakter-panjang"
# Bawaan mati: nyalakan hanya setelah ruang lingkup dan kebijakan retensi
# ditetapkan. Hanya nomor WhatsApp PERUSAHAAN yang boleh dipantau.
WHATSAPP_MONITORING_ENABLED=true

# --- Enkripsi kolom data pribadi ---
# Kunci induk AES-256 untuk isi pesan WhatsApp (dan kolom sensitif lain nanti).
# Kunci khusus test, boleh dipakai apa adanya — database test tidak berisi
# data sungguhan. JANGAN dipakai di .env produksi.
FIELD_ENCRYPTION_KEY="a3VuY2ktdWppLXNhamEtamFuZ2FuLWRpcGFrYWktMzI="

# Masa simpan arsip percakapan dalam hari. 0 = tanpa batas (bawaan).
# Penghapusan tidak otomatis: panggil POST /api/whatsapp/retention/purge
# dari cron di luar aplikasi.
WHATSAPP_RETENTION_DAYS=0

# --- Driver WhatsApp (Baileys, berjalan di dalam backend) ---
# Backend membuka koneksi WhatsApp sendiri, tanpa layanan pihak ketiga.
# Satu nomor WhatsApp hanya boleh dipegang SATU proses: kalau backend
# dijalankan lebih dari satu instance, nyalakan ini hanya di salah satunya.
WHATSAPP_BAILEYS_ENABLED=false
# Kredensial sesi WhatsApp. Isinya setara akses penuh ke akun WhatsApp itu;
# jangan disajikan ke publik dan jangan ikut masuk git.
WHATSAPP_SESSION_DIR=./whatsapp-sessions

# --- Notifikasi push ke ponsel karyawan (Firebase Cloud Messaging) ---
# Memberi tahu pemegang nomor saat sesi WhatsApp-nya terputus atau perlu
# discan ulang. Butuh berkas JSON service account dari Firebase Console.
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=
